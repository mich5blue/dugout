# Firebase web config for the dugout-2069e project.
#
# Public by design — a web config identifies the project, it does not authorize
# anything. Access is decided by firestore.rules.
#
# These are NEXT_PUBLIC_, so Next.js inlines them at build time. Changing them
# needs a dev-server restart locally, and a redeploy on Netlify.
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyCRu55myvQcxxewVtUZ-re1gfRqE-Z2djc
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=dugout-2069e.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=dugout-2069e
NEXT_PUBLIC_FIREBASE_APP_ID=1:811490679481:web:58f61bf80d1a20279fd968

# Optional; not read by Firestore or Auth in this app.
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=dugout-2069e.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=811490679481

# Server-side only. Enables roster import from a photo. Leave blank to disable;
# the feature explains itself and the paste path still works.
ANTHROPIC_API_KEY=
