{
  "name": "dugout",
  "version": "0.1.0",
  "private": true,
  "description": "Smart lineups for youth baseball & softball.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:palette": "node scripts/validate_palette.mjs",
    "emulator": "firebase emulators:start --only firestore",
    "test:rules": "firebase emulators:exec --only firestore \"vitest run --config vitest.rules.config.ts\"",
    "test:all": "npm run test && npm run test:rules",
    "build:emulator": "NEXT_PUBLIC_FIREBASE_EMULATOR=1 NEXT_PUBLIC_FIREBASE_API_KEY=emulator-key NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=127.0.0.1 NEXT_PUBLIC_FIREBASE_PROJECT_ID=dugout-e2e NEXT_PUBLIC_FIREBASE_APP_ID=emulator-app next build",
    "test:e2e:firebase": "npm run build:emulator && firebase emulators:exec --only firestore,auth --project dugout-e2e \"playwright test --config playwright.firebase.config.ts\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "clsx": "^2.1.1",
    "firebase": "^12.19.0",
    "next": "^15.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwind-merge": "^3.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.18.1",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
