# Firebase web config. These are public by design — a web config identifies the
# project, it does not authorize anything. Access is decided by firestore.rules.
#
# With none of these set, Dugout falls back to browser storage: useful for local
# development and required for the test suites, which must run with no network.
#
# These are NEXT_PUBLIC_, so Next.js inlines them at build time. Changing them
# in Netlify needs a redeploy, not just a restart.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional; not used by Firestore or Auth.
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# Server-side only. Enables roster import from a photo.
ANTHROPIC_API_KEY=
